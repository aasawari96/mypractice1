<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Testing Suite" parallel="tests" thread-count="2">


	<test name="ChromeTest">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="testcases.Class1_UIValidation" />
			<class name="testcases.Class2_PlaceholderTitleURL" />
			<class name="testcases.Class3_DataDrivenFactorial" />
			<class name="testcases.Class4_AboutLink" />
			<class name="testcases.Class5_BugScenario" />
		</classes>
	</test>

	<test name="EdgeTest">
		<parameter name="browser" value="edge" />
