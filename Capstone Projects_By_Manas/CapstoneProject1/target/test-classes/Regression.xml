			<class name="testcases.Class1_UIValidation" />
			<class name="testcases.Class2_PlaceholderTitleURL" />
			<class name="testcases.Class3_DataDrivenFactorial" />
			<class name="testcases.Class4_AboutLink" />
			<class name="testcases.Class5_BugScenario" />
		</classes>
	</test>


</suite>